# =================================================================
# OmniStock / Bandhu Chol Inventory System - Environment Config
# Rename this file to .env on your server and update the values
# =================================================================

# Application Environment
# Options: 'production' | 'development'
APP_ENV=production

# Debug Mode (Keep false in production to prevent leaking sensitive errors)
APP_DEBUG=false

# Timezone (e.g., UTC, Asia/Kolkata, America/New_York, Europe/London)
APP_TIMEZONE=Asia/Kolkata

# Optional: Force explicit Base URL or Domain (Leave blank for automatic detection)
# Examples:
# APP_URL=https://inventory.yourdomain.com
# APP_URL=https://yourdomain.com/inventory
APP_URL=

# -----------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------
# Driver: 'mysqli' (recommended for production MySQL/MariaDB) or 'sqlite'
DB_DRIVER=mysqli

# Database Connection Details
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=test
DB_USERNAME=K7kGYdYzup79K6J.root
DB_PASSWORD=vHsQYZ4P19RRw1x7
DB_SSL=true

# Alternative: Universal Cloud Database URL (Used by Render, Railway, Heroku, Fly.io)
# If provided, DATABASE_URL overrides individual DB_* settings above.
